# Meter — local configuration. Copy to `.env`; `.env` is gitignored and must stay that way.
#
# Variables are grouped by owner so you only have to fill in the ones your piece needs.
# Anything marked REQUIRED has no safe default and the proxy will refuse to start without it.

# ─────────────────────────────────────────────────────────────────────────────
# Provider keys (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
# The "master company key" from CONTEXT.md §3. Callers never send these; they send
# a Meter key, and the proxy substitutes the provider key on the way out. That
# substitution is the entire reason a client can point an SDK at Meter without
# handing Meter's operator a key it did not already own.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Upstream base URLs. Override to point at a mock/record-replay server during a demo
# so a flaky conference network cannot break the pitch.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Sent upstream on Anthropic requests when the caller does not supply its own.
ANTHROPIC_VERSION=2023-06-01

# Seconds to wait for the upstream provider. Streams routinely run minutes, so this
# is a *connect/read* timeout on individual socket operations, not a total budget.
UPSTREAM_TIMEOUT_S=600
UPSTREAM_CONNECT_TIMEOUT_S=10

# ─────────────────────────────────────────────────────────────────────────────
# Meter keys and projects (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated `meter_key:project_id:environment:scopes` entries, seeded into the DB
# at startup. Keys are stored as SHA-256 hashes, never in plaintext (ARCHITECTURE.md §4
# specifies `meter_keys.hash`). Re-seeding is idempotent.
#
# `environment` defaults to `dev`. `scopes` is optional and `|`-separated (`:` and `,`
# are both already taken by this format). Omitting it means UNRESTRICTED, which is what
# every key issued before scoping has — see PROPOSALS.md B19.
#
#   proxy   /v1/* — metered inference
#   money   anything that charges, tops up, credits, or drives the Treasurer
#   read    treasury reads: balances, mandates, event history
#
# A key that only needs to send inference should say so. The default below is
# unrestricted because it is also what WALKTHROUGH.md publishes, and narrowing it
# silently would break the documented walkthrough — narrow it deliberately when the
# walkthrough is updated to match:
#
#   METER_KEYS=mk_dev_local:demo-project:dev:proxy,mk_ops:demo-project:dev:money|read
#
# This is a Phase 1 shim. Once Shivam's project/key tables land, keys get provisioned
# through the DB and this variable goes away.
METER_KEYS=mk_dev_local:demo-project:dev

# How long a resolved key stays cached in-process, in seconds. 0 disables. Revocation is
# NOT delayed by this — every path that revokes or re-scopes purges the cache
# synchronously; the TTL only bounds a change made outside this process.
KEY_CACHE_TTL_S=5

# Origins allowed to call this API from a browser. Comma-separated; `*` permits any.
#
# NOT wildcarded, deliberately. The judge console sends a session token in
# `X-Judge-Session`, and a token is worth exactly as much as the origins allowed to send
# it — a wildcard would let any page on the internet drive somebody's live session.
# Preview deployments of a project already named here are matched too; a bare `*.vercel.app`
# regex was the hole the 2026-08-03 security audit closed.
#
# ⚠ Update this when the dashboard URL changes, or the console silently stops working
# against the API. DEPLOY.md says so; this file did not mention the variable existed.
#
# Setting `*` also DISABLES the judge money capability, because
# `Access-Control-Allow-Origin: *` with credentials is rejected by every browser
# (PROPOSALS.md B20). `/judge/topup` and `/judge/mandate` will 403.
CORS_ALLOW_ORIGINS=https://meter-five-nu.vercel.app,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Additionally allow Vercel PREVIEW deployments of the projects named above. OFF by
# default, deliberately (PROPOSALS.md B22): the preview pattern must match
# `<project>-<anything>.vercel.app`, and `vercel.app` subdomains are first-come-
# first-served — so someone can register `meter-three-beta-evil.vercel.app` and be inside
# the allowlist. With credentialed CORS on for the judge money capability, such an origin
# would receive that cookie automatically.
#
# Prefer naming the specific preview URL in CORS_ALLOW_ORIGINS above.
CORS_ALLOW_VERCEL_PREVIEWS=false

# Relaxes the judge money capability cookie from `SameSite=None; Secure` to `Lax` without
# `Secure`, for LOCAL DEVELOPMENT ONLY (PROPOSALS.md B20).
#
# ⚠ NEVER set this in a deployment. `Secure` requires HTTPS, so on a plain-http dev origin
# the browser silently drops the cookie and every judge money route 403s with nothing
# explaining why — that is the only problem this solves. Setting it in production makes a
# secret that gates charging a real card same-site-only and sends it in clear over http.
JUDGE_CAPABILITY_INSECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# Ledger (Shubh — proxy; on Postgres, see DATABASE_URL below)
# ─────────────────────────────────────────────────────────────────────────────
# The ledger is Postgres. Set DATABASE_URL near the bottom of this file — the proxy
# raises at first query without it rather than degrading, because a proxy that cannot
# bill anyone should not be serving.

# Which `pricing/{version}.yaml` to price against. Stored per ledger row, so historical
# rows stay reproducible when rates change (ARCHITECTURE.md §3).
PRICING_VERSION=2026-08-01

# `open` (default) or `closed`. Fail-open serves the request when the ledger is
# unreachable; fail-closed drops the traffic instead. README.md "Fail mode".
FAIL_MODE=open

# ─────────────────────────────────────────────────────────────────────────────
# Budgets and reservations (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Daily ceilings are declared in `meter.yaml` at the repo root, NOT here, so spend
# limits are reviewed by pull request (README.md). See meter.yaml.example. If the file
# is absent there are no ceilings and nothing is enforced — the Phase 1 behaviour.
METER_YAML_PATH=meter.yaml

# The window `ceiling_usd_per_day` is measured over. Rolling, not calendar-aligned: a
# midnight reset would let a runaway loop spend a full ceiling at 23:59 and another at
# 00:01.
BUDGET_WINDOW_S=86400

# How long an unreleased reservation survives before it is reaped. Deliberately short so
# a crashed worker frees its holds (ARCHITECTURE.md §2). Streams outlive this routinely,
# which is why the streaming loop heartbeats the TTL rather than raising it — raising it
# instead would let a crashed worker's holds outlive the incident.
RESERVATION_TTL_S=120
RESERVATION_HEARTBEAT_S=30

# Soft budgets (PROPOSALS.md D2) — the warning that arrives BEFORE the hard 429, while
# there is still time to do something about it. At this fraction of any ceiling, an
# iMessage goes out naming the same scope string the eventual refusal will name. It is a
# background poll, not a per-request check: 80%-full is a level rather than an edge, so
# testing it inline would re-evaluate the same condition thousands of times to send at
# most one message. Needs the POKE_* block below to be configured to actually deliver;
# without it the breach is logged and nothing is sent.
BUDGET_SOFT_ALERT_ENABLED=true
BUDGET_SOFT_ALERT_RATIO=0.8
BUDGET_SOFT_ALERT_INTERVAL_S=60

# The pre-flight cost estimate (ARCHITECTURE.md §2 step 3, predictor/). Off leaves the
# `predicted_*` ledger columns NULL and reserves $0 against ceilings, which is exactly
# the Phase 1 behaviour. Claude models take that path regardless: tiktoken has no
# Anthropic vocabulary and the predictor refuses to guess (predictor/README.md).
PREDICT_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Circuit breaker (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
BREAKER_ENABLED=true

# Detection is two conditions and BOTH must hold (ARCHITECTURE.md §6).
#
# 1. FLOOR — trailing BREAKER_WINDOW_S spend must clear BREAKER_WINDOW_USD. This is the
#    "$20 in 5 minutes" from CONTEXT.md §5C, and it is what makes detection fast.
BREAKER_WINDOW_S=300
BREAKER_WINDOW_USD=20.0

# 2. BURST — that window's spend *rate* must exceed the trailing baseline window's average
#    rate by this multiple. Without it, a feature that legitimately costs more than the
#    floor trips the breaker every five minutes forever.
#
#    The ratio is capped by the window sizes: 3600/300 = 12x maximum. A threshold above
#    the ceiling makes the breaker unfirable. Set BREAKER_BURST_RATIO=0 to disable the
#    burst check and fall back to the flat floor — the escape hatch if it misbehaves live.
BREAKER_BASELINE_WINDOW_S=3600
BREAKER_BURST_RATIO=3.0

# `throttle` returns 429 for the offending attribution tag only and lets all other
# traffic flow (the right answer to a retry storm). `revoke` cuts the Meter key
# entirely with a 403 (the right answer to a leaked credential).
BREAKER_MODE=throttle

# How long a tripped breaker stays shut before it half-opens and re-evaluates.
# Without this the demo trips the breaker and strands you on stage.
BREAKER_COOLDOWN_S=120

# ─────────────────────────────────────────────────────────────────────────────
# Treasurer / Prava (Shivam — not read by the proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Prava sandbox key naming per docs/prava/authentication.md: secret key is server-side
# only (sk_test_*), used for session/mandate/card API calls.
PRAVA_API_KEY=sk_test_xxx
# Standing mandate the Treasurer Agent charges against — see docs/prava/concepts/mandates.md
PRAVA_MANDATE_ID=

# Sandbox: https://sandbox.api.prava.space · Production: https://api.prava.space
# The key must match the host — an sk_test_* key against the production host is a 401,
# and an sk_live_* key against sandbox silently tests nothing.
PRAVA_API_BASE=https://sandbox.api.prava.space

# ⚠ ON means REAL charges against the Prava sandbox. Off falls back to a SIMULATED
# charge that returns a plausible `awaiting_result` after a 1.2s sleep.
#
# **Parsing changed 2026-08-01.** This used to be an exact `== "True"` comparison in
# prava.py, so `true` / `TRUE` / `1` all silently evaluated FALSE and simulated — a
# failure mode that looks identical to success on stage. It is now parsed by
# `treasury/config.py:_bool` like every other boolean here, so `true`, `1`, `yes` and
# `on` all mean ON. If you had `PRAVA_LIVE_MODE=true` and were relying on it quietly
# simulating, it will now transact. Set it to `false` if that is what you meant.
PRAVA_LIVE_MODE=True

# Rehearses the full top-up decision path and logs it without transacting.
# Defaults to true and stays true unless someone explicitly asks otherwise.
TREASURER_DRY_RUN=true
TREASURER_MAX_TOPUP_USD=200
TREASURER_MAX_DAILY_USD=500

# Burn-rate check interval. 30s is the documented default and what a real deployment
# should run — the Treasurer is heavily rate-limited by design and a tighter loop mostly
# spends someone's sandbox quota. Drop it to 3 on the DEMO BOX ONLY: a 30-second silence
# on stage while everyone waits for the top-up is a bad 30 seconds.
# ⚠ Confirm the Prava sandbox rate limit before running at 3 (PROPOSALS.md A3, C3).
TREASURER_INTERVAL_S=30

# Minimum gap between two top-ups on the same wallet. The rail that stops a bad burn-rate
# reading from charging the mandate repeatedly in the same minute (ARCHITECTURE.md §5).
TREASURER_COOLDOWN_S=300

# Which provider's credits the mandate tops up. One provider in Phase 1; a second
# mandate for Anthropic is a row in `mandates`, not a migration.
TREASURER_PROVIDER=openai

# Does the loop wake up at all. This is the FIRST of the two switches that stand between
# the process and a card: `TREASURER_ENABLED` decides whether it runs, `TREASURER_DRY_RUN`
# above decides whether it may move money. Off by default so importing the app never
# starts a money-moving timer by accident.
TREASURER_ENABLED=false

# The two triggers, and the second is not redundant. `TOPUP_WHEN_HOURS` is the predictive
# one: hours of runway left at the current burn rate. `MIN_BALANCE_USD` is an absolute
# floor — at zero traffic burn is 0 and runway is infinite, so a wallet sitting at $0.00
# would never trip the runway check.
TREASURER_TOPUP_WHEN_HOURS=0.75
TREASURER_MIN_BALANCE_USD=10

# How far back burn rate is measured. One hour smooths a spiky minute without being so
# long that a genuine surge takes an hour to show up.
TREASURER_BURN_WINDOW_S=3600

# How much runway a top-up aims to restore, and the floor on any single top-up. The amount
# is shortfall-to-target, clamped between MIN_TOPUP and MAX_TOPUP above.
TREASURER_TARGET_HOURS=24
TREASURER_MIN_TOPUP_USD=25

# ── Mandate creation defaults (POST /mandates/create) ────────────────────────
# What the approval page shows the person entering a card. `MERCHANT_*` is what Prava
# displays and pins the mandate to; `merchant_scope` is always `listed`, which is what
# makes the mandate reusable rather than one-time.
MANDATE_DEFAULT_AMOUNT_USD=50
MANDATE_MERCHANT_NAME=Meter
MANDATE_MERCHANT_URL=https://meter.dev
MANDATE_MERCHANT_COUNTRY=US
# Optional. Where Prava redirects after approval; blank means no redirect.
MANDATE_CALLBACK_URL=
# The largest mandate this sandbox can actually mint card credentials against. Mandates
# above it approve fine and then fail at "Fetching cryptogram failed", so the selector
# uses this to prefer a mandate that works over one that merely has more headroom.
MANDATE_MINTABLE_MAX_USD=50

# ── Predictor online learning (Ammar) ────────────────────────────────────────
# The loop that re-fits the per-(project, feature) correction from the ledger while the
# proxy runs. Safe to leave on: candidates are fitted on older rows and installed only if
# they beat the current factors on newer rows the fit never saw, so the worst case is
# "no change" rather than "worse". Never touches the request path — `predict()` only reads
# an in-memory dict this writes.
PREDICT_REFRESH_ENABLED=true
PREDICT_REFRESH_INTERVAL_S=120

# ─────────────────────────────────────────────────────────────────────────────
# Alerts — Poke / Linq iMessage (Tanay)
# ─────────────────────────────────────────────────────────────────────────────
# Read by `alerts/` and dispatched from proxy.breaker.notify() when a breaker
# trips. Leave these blank and alerting stays silent — the breaker still logs.
#
# Bearer token from your Linq representative (docs/linq/getting-started/).
POKE_API_KEY=
# Destination, E.164 only: +14155551234. Anything else is rejected at boot
# rather than failing as an unsent alert mid-incident.
POKE_CTO_PHONE=

# Master kill switch, separate from whether credentials are present, so alerting
# can be silenced for a rehearsal without deleting the token.
POKE_ENABLED=true

# Minimum seconds between messages for the same breaker scope. A breaker
# half-opens and re-trips while a burst continues; without this floor one
# runaway feature texts somebody every few seconds.
POKE_COOLDOWN_S=300

# Dispatch is off-thread and nobody awaits the result, but a hung socket still
# holds a thread.
POKE_TIMEOUT_S=5
POKE_API_BASE=https://api.linqapp.com/api/partner/v3

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard (Tanay — Next.js, not read by the proxy)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ Neither of these is read by anything today — checked across dashboard/src, proxy/ and
# treasury/. They are placeholders for a client-side Prava flow that was never built; the
# dashboard talks to Postgres directly and never calls the proxy except for its own
# /api routes. Setting them does nothing. Kept rather than deleted because the
# "Connect your card" flow (POST /mandates/create → GET /mandates/status) would need the
# first one — delete both if that flow stays server-side.
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_METER_API_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Postgres (Shivam) — REQUIRED. This is the ledger.
# ─────────────────────────────────────────────────────────────────────────────
# Everything writes here: the proxy's `requests`, the treasury's wallets/mandates/
# events, and the predictor's learning loop reads it. The dashboard reads the same
# database (see dashboard/.env.example) — it is the only thing the two share.
#
# Hosted rather than a local file so the whole team, the deployed proxy and the
# dashboard on Vercel all see the same history. That matters beyond convenience: the
# predictor needs ~20 rows for a (project, feature) key before its correction beats
# the raw heuristic, so anyone running against an empty local database gets the
# *worse* accuracy number.
#
# Ours is Supabase, ap-south-1. Local Postgres works identically:
#   docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Schema to use. `public` is the real one. The test suites and the scratch harnesses
# override this with a throwaway schema and drop it afterwards, which is what keeps a
# test run from touching the demo's data.
DB_SCHEMA=public

# Pooled connections. The proxy makes a few queries per request, so a pool rather than
# a connection per call — the handshake would otherwise dominate every other
# millisecond in the request path.
DB_POOL_MIN=1
DB_POOL_MAX=10

# Redis stays post-hackathon. It is not what makes reservations correct — serialization
# is, and with a single proxy process an in-process lock is the identical guarantee.
# It becomes load-bearing at proxy replica #2. See ARCHITECTURE.md §2, PROPOSALS.md A5.
# REDIS_URL=redis://localhost:6379
